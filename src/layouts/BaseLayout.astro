---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "lenis/dist/lenis.css";
import Navbar from "../components/Navbar.astro";

interface Props {
  title?: string;
  description?: string;
  /* Auth screens sit on their own canvas: no navbar, no footer slot. */
  bare?: boolean;
}

const {
  title = "Latch — Verified business intelligence",
  description = "Latch gives you verified business data, credit signals and monitoring in one platform.",
  bare = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Preload the display font so the H1 doesn't flash the Inter fallback. */}
    <link
      rel="preload"
      href="/fonts/SeasonCollectionVF-TRIAL.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add("js");
      // A reload should land at the top; the hero's entrance animation shifts
      // layout for a moment, so a restored offset never matches anyway. History
      // navigation keeps its own restoration.
      const nav = performance.getEntriesByType?.("navigation")?.[0];
      if (!location.hash && nav?.type === "reload") history.scrollRestoration = "manual";
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="page-transition-bar" aria-hidden="true" transition:persist data-page-progress></div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-lg"
    >
      Skip to content
    </a>

    {!bare && <Navbar />}

    <main
      id="main"
      tabindex="-1"
      transition:name="page-content"
      class={bare ? "flex min-h-dvh flex-col" : undefined}
    >
      <slot />
    </main>

    <slot name="footer" />
    <script>
      import { initMotion } from "../scripts/motion";
      import { initSmoothScroll } from "../scripts/smooth-scroll";

      let cleanups: Array<() => void> = [];
      let started = false;
      let hasNavigated = false;

      const setProgress = (state: "idle" | "loading" | "finishing") => {
        const bar = document.querySelector<HTMLElement>("[data-page-progress]");
        if (!bar) return;
        if (state === "idle") {
          delete bar.dataset.state;
        } else {
          bar.dataset.state = state;
        }
      };

      const start = () => {
        if (started) return;
        started = true;
        cleanups = [initSmoothScroll(), initMotion({ isNavigation: hasNavigated })];
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", start, { once: true });
      } else {
        start();
      }

      document.addEventListener("astro:before-preparation", () => {
        setProgress("loading");
      });

      document.addEventListener("astro:before-swap", () => {
        hasNavigated = true;
        cleanups.forEach((fn) => fn());
        cleanups = [];
        started = false;
      });

      document.addEventListener("astro:page-load", () => {
        setProgress("finishing");
        window.setTimeout(() => setProgress("idle"), 360);
        start();
      });
    </script>
  </body>
</html>
