---
interface Layer {
  art: { src: string; width: number; height: number };
  title: string;
  description: string;
}

const layers: Layer[] = [
  {
    art: { src: "/images/platforms/overview/security-layers.svg", width: 283, height: 283 },
    title: "4 Security Layers",
    description:
      "Secure your identities, apps, APIs, and infrastructure with one platform easily.",
  },
  {
    art: { src: "/images/platforms/overview/detect-risks.svg", width: 269, height: 269 },
    title: "Detect Risks in Under 24 Hours",
    description:
      "Watch activity all the time and spot risky issues early. Automated checks help teams stay safe.",
  },
  {
    art: { src: "/images/platforms/overview/continous-testing.svg", width: 271, height: 271 },
    title: "Continuous testing",
    description:
      "Always-on scanning of applications and APIs that surfaces real vulnerabilities before production.",
  },
];
---

<section
  class="bg-white py-16 lg:pt-[100px] lg:pb-[100px]"
  aria-labelledby="overview-title"
  data-overview
>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-[120px]">
    <div class="flex flex-col gap-10">
      <header class="flex flex-col items-start gap-4">
        <p
          class="inline-flex h-8 items-center gap-2 border border-border-badge bg-white px-[9px]"
          data-ov-badge
        >
          <span class="size-2.5 bg-[#607AFF]" aria-hidden="true"></span>
          <span class="font-sans text-sm font-medium uppercase tracking-[0.28px] text-ink-muted">
            Overview
          </span>
        </p>
        <div class="flex flex-col items-start gap-3">
          <h2
            id="overview-title"
            class="font-display text-[42px] leading-[1.16] tracking-normal text-ink font-mix-medium max-lg:text-[32px] max-lg:leading-[1.25] max-sm:text-[26px]"
            data-ov-title
          >
            One platform across your entire stack
          </h2>
          <p
            class="font-sans text-[20px] leading-[1.3] text-ink-muted max-sm:text-base"
            data-ov-sub
          >
            From APIs and application logic to identity and infrastructure, every
            layer stays visible, tested, and protected in real time.
          </p>
        </div>
      </header>

      <ul class="m-0 grid list-none grid-cols-2 gap-6 p-0 max-md:grid-cols-1 max-md:gap-10 lg:grid-cols-3">
        {
          layers.map((layer) => (
            <li
              class="flex flex-col gap-[26px] md:max-lg:last:col-span-2 md:max-lg:last:mx-auto md:max-lg:last:w-[calc(50%-12px)]"
              data-ov-card
            >
              <div class="flex aspect-[384/391] items-center justify-center overflow-hidden bg-panel">
                <img
                  src={layer.art.src}
                  alt=""
                  aria-hidden="true"
                  width={layer.art.width}
                  height={layer.art.height}
                  class="h-auto max-h-full max-w-full"
                  style={`width: ${((layer.art.width / 384) * 100).toFixed(2)}%`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex flex-col items-start gap-2">
                <h3 class="m-0 font-sans text-[20px] font-medium leading-[23.2px] text-ink">
                  {layer.title}
                </h3>
                <p class="m-0 max-w-full font-sans text-base leading-6 text-ink-muted lg:max-w-[375px]">
                  {layer.description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
