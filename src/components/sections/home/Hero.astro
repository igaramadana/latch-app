---
import CtaButton from "../../CtaButton.astro";

const ctas = [
  { label: "Start for free", href: "/signup", variant: "primary" as const },
  { label: "Book a demo", href: "/contact", variant: "secondary" as const },
];

const announcements = {
  badge: "News",
  text: "Security that runs as your system runs",
};
---

<section class="relative isolate overflow-hidden bg-hero-bg" aria-labelledby="hero-title" data-hero>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="absolute inset-x-0 bottom-0 h-[200px] sm:h-[300px] md:h-[380px] lg:h-[551px]"
      data-hero-pattern
    >
      <img
        class="absolute inset-0 h-full w-full object-cover object-top opacity-70"
        src="/images/home/hero/pattern-mirror.webp"
        alt=""
        width="1440"
        height="551"
        loading="eager"
        decoding="async"
        fetchpriority="low"
      />

      <div
        class="absolute inset-x-0 top-0 h-[72px] sm:h-[120px] md:h-[160px] lg:h-[266px] bg-linear-to-b from-hero-bg to-[rgb(241_246_253_/_0)]"
      >
      </div>
    </div>

    <div
      class="absolute inset-x-0 bottom-0 h-[220px] sm:h-[340px] md:h-[420px] lg:h-[674px] bg-linear-to-b from-[rgb(241_246_253_/_0)] to-hero-bg"
    >
    </div>
  </div>

  <div
    class="relative mx-auto max-w-[1440px] px-6 pt-[calc(var(--spacing-nav)+32px)] pb-4 md:px-10 md:pt-[calc(var(--spacing-nav)+48px)] lg:pt-[calc(var(--spacing-nav)+118px)] lg:pb-0"
  >
    <div class="mx-auto flex max-w-[840px] flex-col items-center gap-6 text-center md:gap-8">
      <div class="flex flex-col items-center gap-4 md:gap-6">
        <div
          class="inline-flex flex-wrap items-center justify-center gap-3"
          data-hero-badge
        >
          <span
            class="inline-flex h-6 items-center justify-center rounded-sm bg-hero-badge px-2 font-sans text-[12.9px] font-medium uppercase leading-[18.4px] text-hero-badge-ink"
          >
            {announcements.badge}
          </span>
          <span class="font-sans text-sm font-medium leading-[22.5px] text-balance text-black">
            {announcements.text}
          </span>
        </div>

        <h1
          id="hero-title"
          class="font-display text-[72px] leading-[1.2] text-balance text-ink max-lg:text-[60px] max-md:text-[48px] max-sm:text-[36px] font-mix-medium"
          data-hero-title
        >
          Proven Security SaaS<br />
          Data Security
        </h1>
      </div>

      <p
        class="max-w-[532px] font-sans text-[20px] leading-[1.5] text-pretty text-ink-muted max-sm:text-base"
        data-hero-sub
      >
        Secure applications, identities, and data with continuous testing and
        identity-aware protection.
      </p>

      <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-[11px] p-0 max-sm:w-full max-sm:flex-col">
        {
          ctas.map((cta) => (
            <li class="max-sm:w-full">
              <CtaButton
                href={cta.href}
                variant={cta.variant}
                class="max-sm:w-full"
                data-hero-cta
              >
                {cta.label}
              </CtaButton>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div
    class="relative mx-auto mt-0 aspect-[1329/729] w-full max-w-[1329px] overflow-hidden [@media(width>=1025px)]:mt-1"
    data-hero-art
  >
    <div class="relative w-full">
      <img
        class="block w-full"
        src="/images/home/hero/isometric-fresh.svg"
        alt="Latch security platform shown as an isometric diagram of connected services"
        width="1329"
        height="977.5"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />

      <div
        class="pointer-events-none absolute inset-0"
        data-hero-cards
      >
        <img
          class="absolute left-[18.6%] top-[7.83%] w-[20.5%]"
          src="/images/home/hero/card-left.svg"
          alt=""
          aria-hidden="true"
          decoding="async"
          width="273"
          height="237"
          data-hero-card="left"
        />
        <img
          class="absolute left-[62.8%] top-[7.83%] w-[20.5%]"
          src="/images/home/hero/card-right.svg"
          alt=""
          aria-hidden="true"
          decoding="async"
          width="273"
          height="237"
          data-hero-card="right"
        />
        <img
          class="absolute left-[82.3%] top-[31.92%] w-[17.7%]"
          src="/images/home/hero/card-far.svg"
          alt=""
          aria-hidden="true"
          decoding="async"
          width="235"
          height="266"
          data-hero-card="far"
        />
        <img
          class="absolute left-[13.3%] top-[46.01%] w-[20.5%]"
          src="/images/home/hero/card-left.svg"
          alt=""
          aria-hidden="true"
          decoding="async"
          width="273"
          height="237"
          data-hero-card="lower-left"
        />
        <img
          class="absolute left-[64.6%] top-[45.12%] w-[20.5%]"
          src="/images/home/hero/card-right.svg"
          alt=""
          aria-hidden="true"
          decoding="async"
          width="273"
          height="237"
          data-hero-card="lower-right"
        />
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[clamp(64px,13vw,186px)] bg-linear-to-b from-[rgb(241_246_253_/_0)] to-hero-bg"
    aria-hidden="true"
  >
  </div>
</section>
