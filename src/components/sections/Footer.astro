---

<footer class="bg-[#03060F] pt-20 pb-5 px-6 min-[1360px]:px-[100px]" data-footer>
  <div class="mx-auto flex max-w-[1240px] flex-col gap-12 min-[1024px]:gap-[51px]">
    <div class="flex flex-col gap-12 min-[1024px]:min-h-[306px] min-[1024px]:flex-row min-[1024px]:items-start min-[1024px]:justify-between">
      <div class="flex flex-col gap-3.5" data-footer-brand>
        <a href="/" class="flex items-center gap-2 no-underline" aria-label="Latch — home">
          <svg
            class="size-[25px] flex-none text-white"
            width="24"
            height="26"
            viewBox="0 0 24 26"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M6.61832 12.7385L9.70992 20.7455H4.14504L2.12977 15.4909H0L5.9542 0H11.5191L6.61832 12.7385Z"
              fill="currentColor"></path>
            <path
              d="M17.3817 12.7385L14.2901 4.73143H19.855L21.8702 9.98604H24L18.0458 25.4769H12.4809L17.3817 12.7385Z"
              fill="currentColor"></path>
          </svg>
          <span class="font-sans text-brand font-semibold leading-none text-white">Latch</span>
        </a>

        <p class="m-0 font-sans text-[11px] leading-4 tracking-[0.15px] text-[#A1A1AA]">
          Copyright © 2026 Latch.
        </p>

        <ul class="m-0 mt-2 flex list-none items-center gap-4 p-0">
          {
            socials.map((social) => (
              <li data-footer-social>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="inline-flex size-[18px] items-center justify-center text-white/90 no-underline transition-colors duration-150 hover:text-white"
                >
                  <svg viewBox="0 0 24 24" class="size-[18px]" fill="currentColor" aria-hidden="true">
                    <path d={social.path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 min-[1024px]:flex min-[1024px]:gap-20">
        {
          columns.map((column) => (
            <div class="flex flex-col gap-3" data-footer-col>
              <p class="m-0 font-sans text-[15px] leading-[22.5px] text-white">{column.heading}</p>
              <ul class="m-0 flex list-none flex-col gap-3 p-0">
                {column.links.map((label) => (
                  <li>
                    <a
                      href={label
                        .toLowerCase()
                        .replace(/&/g, "")
                        .replace(/[^a-z0-9]+/g, "-")
                        .replace(/(^-|-$)/g, "")}
                      class="font-sans text-sm leading-[22.5px] text-white/70 no-underline transition-colors duration-150 hover:text-white"
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div
      class="m-0 flex flex-row flex-wrap items-center justify-between gap-2 border-t border-white/10 pt-3 pb-3 min-[480px]:gap-0"
      data-footer-bar
    >
      <p class="m-0 font-sans text-xs font-medium uppercase leading-[18px] tracking-[0.96px] text-[#A5B3C5]">
        Latch © 2026
      </p>
      <p class="m-0 font-sans text-xs font-medium uppercase leading-[18px] tracking-[0.96px] text-[#A5B3C5]">
        All rights reserved.
      </p>
    </div>
  </div>
</footer>
