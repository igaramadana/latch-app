---
interface Audience {
  key: "leaders" | "devsecops" | "detect" | "cloud";
  icon: string;
  title: string;
  description: string;
}

const audiences: Audience[] = [
  {
    key: "leaders",
    icon: "/images/platforms/who-we-serve/shield-03.svg",
    title: "Security leaders",
    description:
      "Full-stack visibility and audit-ready reporting in one place for CISOs and security teams.",
  },
  {
    key: "devsecops",
    icon: "/images/platforms/who-we-serve/devsecops.svg",
    title: "DevSecOps",
    description:
      "Security that runs inside the pipeline so engineers ship fast without trade-offs.",
  },
  {
    key: "detect",
    icon: "/images/platforms/who-we-serve/Solid.svg",
    title: "Detect",
    description:
      "AI models surface and prioritize abnormal behavior before it becomes a breach.",
  },
  {
    key: "cloud",
    icon: "/images/platforms/who-we-serve/building-07.svg",
    title: "Cloud-native companies",
    description:
      "Protection designed for modern, fast-moving SaaS from startup to enterprise scale.",
  },
];

// 1px rules between cells, plus the frame the whole block sits in.
const cellRules: Record<Audience["key"], string> = {
  leaders: "border-b sm:border-r",
  devsecops: "border-b",
  detect: "border-b sm:border-b-0 sm:border-r",
  cloud: "",
};

const avatars = [1, 2, 3, 4].map(
  (n) => `/images/platforms/who-we-serve/avatar${n}.webp`,
);
---

<section
  class="relative isolate overflow-hidden bg-hero-bg py-16 lg:pt-[100px] lg:pb-[74px]"
  aria-labelledby="who-we-serve-title"
  data-who-we-serve
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-x-0 top-[245px] h-[674px]" data-wws-pattern>
      <img
        src="/images/platforms/who-we-serve/pattern.webp"
        alt=""
        class="absolute inset-x-0 top-0 h-auto w-full opacity-[0.095]"
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute inset-x-0 top-0 h-[269px] bg-linear-to-b from-hero-bg to-[rgb(241_246_253_/_0)]"
      >
      </div>
      <div
        class="absolute inset-x-0 bottom-0 h-[269px] bg-linear-to-t from-hero-bg to-[rgb(241_246_253_/_0)]"
      >
      </div>
    </div>
  </div>

  <div class="relative mx-auto max-w-[1440px] px-6 lg:px-[120px]">
    <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-16">
      <header class="flex w-full max-w-[738px] flex-col items-center gap-4 text-center">
        <p
          class="inline-flex h-8 items-center gap-2 border border-border-badge bg-white px-[9px]"
          data-wws-badge
        >
          <span class="size-2.5 bg-[#607AFF]" aria-hidden="true"></span>
          <span class="font-sans text-sm font-medium uppercase tracking-[0.28px] text-ink-muted">
            Who We Serve
          </span>
        </p>
        <div class="flex flex-col items-center gap-3">
          <h2
            id="who-we-serve-title"
            class="font-display text-[42px] leading-[1.16] tracking-normal text-ink font-mix-medium max-lg:text-[32px] max-lg:leading-[1.25] max-sm:text-[26px]"
            data-wws-title
          >
            Built for every security-minded team
          </h2>
          <p
            class="max-w-[540px] font-sans text-[20px] leading-[1.3] text-pretty text-ink-muted max-sm:text-base"
            data-wws-sub
          >
            From the first hire to a full security org, Latch scales with how you
            work.
          </p>
        </div>
      </header>

      <div class="w-full">
        <ul
          class="m-0 grid list-none grid-cols-1 border border-border-badge bg-white p-0 sm:grid-cols-2"
        >
          {
            audiences.map((audience) => (
              <li
                class:list={[
                  "flex flex-col items-center gap-6 border-border-badge px-6 py-[47.5px]",
                  cellRules[audience.key],
                ]}
                data-wws-card
              >
                <div class="grid size-11 place-items-center rounded-[10px] bg-panel p-1.5">
                  <img
                    src={audience.icon}
                    alt=""
                    aria-hidden="true"
                    width="24"
                    height="24"
                    class="size-6"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="flex max-w-[436px] flex-col items-center gap-2 text-center">
                  <h3 class="m-0 font-sans text-[18px] font-medium leading-[27px] text-[#0D0D12]">
                    {audience.title}
                  </h3>
                  <p class="m-0 font-sans text-base leading-6 text-[#666D80]">
                    {audience.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>

        <div
          class="flex flex-col items-center justify-center gap-2 rounded-b-[28px] bg-linear-to-r from-[#6078FF] to-[#6FA6FE] px-4 py-3 sm:h-[52px] sm:flex-row sm:gap-1 sm:py-0"
          data-wws-bar
        >
          <div class="flex items-center" aria-hidden="true">
            {
              avatars.map((src) => (
                <img
                  src={src}
                  alt=""
                  width="96"
                  height="96"
                  class="size-5 rounded-full object-cover outline-2 outline-[#6689FF]"
                  loading="lazy"
                  decoding="async"
                />
              ))
            }
            <span class="grid size-5 place-items-center rounded-full bg-white outline-2 outline-[#6689FF]">
              <img
                src="/images/platforms/who-we-serve/plus.svg"
                alt=""
                width="10"
                height="10"
                class="size-2.5"
              />
            </span>
          </div>
          <p class="m-0 text-center font-sans text-sm font-medium leading-[21px] text-white sm:pl-1 sm:text-left">
            — Over 2,000 people fasted with us.{" "}
            <a href="/signup" class="whitespace-nowrap text-white underline underline-offset-2">
              Get Started →
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
