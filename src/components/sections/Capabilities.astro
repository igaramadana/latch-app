---
interface Capability {
  key: "integrations" | "threat" | "response";
  art: { src: string; width: number; height: number };
  title: string;
  description: string;
  /** Absolute art placement, matching the design frame. */
  artClass: string;
  cardClass: string;
}

const capabilities: Capability[] = [
  {
    key: "integrations",
    art: {
      src: "/images/platforms/capabilities/native_integration.webp",
      width: 1200,
      height: 688,
    },
    title: "100+ Native Integrations",
    description:
      "Easily connect with your tools, cloud, identity systems, and workflows without tricky setup.",
    artClass: "w-[92%] md:max-lg:h-[300px] md:max-lg:w-auto lg:left-[-8px] lg:w-[608px]",
    cardClass: "min-h-[360px] border-b-2 md:max-lg:min-h-[500px] lg:min-h-[472px] lg:border-r-2",
  },
  {
    key: "threat",
    art: { src: "/images/platforms/capabilities/ai-threat.svg", width: 494, height: 291 },
    title: "AI threat detection",
    description:
      "Behavioral models flag abnormal activity and prioritize what matters, cutting alert noise for your team.",
    artClass: "w-[92%] md:max-lg:h-[300px] md:max-lg:w-auto lg:top-[32px] lg:left-[52px] lg:w-[488px]",
    cardClass: "min-h-[360px] border-b-2 md:max-lg:min-h-[500px] lg:min-h-[472px]",
  },
  {
    key: "response",
    art: {
      src: "/images/platforms/capabilities/automated-response.webp",
      width: 1529,
      height: 740,
    },
    title: "Automated response",
    description:
      "Contain and remediate the moment risk appears, with runbooks that act before threats can escalate.",
    artClass: "w-[92%] md:max-lg:h-[300px] md:max-lg:w-auto lg:top-[10px] lg:left-[413px] lg:w-[767px]",
    cardClass: "min-h-[320px] md:max-lg:min-h-[500px] lg:col-span-2 lg:min-h-[389px]",
  },
];
---

<section
  class="bg-white py-16 lg:pt-[100px] lg:pb-[124px]"
  aria-labelledby="capabilities-title"
  data-capabilities
>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-[120px]">
    <div class="flex flex-col items-center gap-16">
      <header class="flex flex-col items-center gap-4 text-center">
        <p
          class="inline-flex h-8 items-center gap-2 border border-border-badge bg-white px-[9px]"
          data-cap-badge
        >
          <span class="size-2.5 bg-[#607AFF]" aria-hidden="true"></span>
          <span class="font-sans text-sm font-medium uppercase tracking-[0.28px] text-ink-muted">
            Capabilities
          </span>
        </p>
        <div class="flex flex-col items-center gap-3">
          <h2
            id="capabilities-title"
            class="font-display text-[42px] leading-[1.16] tracking-normal text-ink font-mix-medium max-lg:text-[32px] max-lg:leading-[1.25] max-sm:text-[26px]"
            data-cap-title
          >
            AI built for security
          </h2>
          <p
            class="font-sans text-[20px] leading-[1.3] text-pretty text-ink-muted max-sm:text-base"
            data-cap-sub
          >
            Intelligent capabilities that test, watch, and respond across your SaaS
            continuously, not on a schedule.
          </p>
        </div>
      </header>

      <ul
        class="m-0 grid w-full list-none grid-cols-1 border-2 border-[#F1F4F8] p-0 lg:grid-cols-2"
      >
        {
          capabilities.map((cap) => (
            <li
              class:list={[
                "relative flex flex-col justify-end overflow-hidden border-[#F1F4F8] px-8 py-7 max-lg:pt-2",
                cap.cardClass,
              ]}
              data-cap-card
            >
              <div class="pointer-events-none relative flex flex-1 items-center justify-center overflow-hidden lg:absolute lg:inset-0 lg:block" aria-hidden="true">
                {cap.key === "response" && (
                  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgb(15_23_42_/_0.05)_1px,transparent_1.1px)] bg-[size:22px_22px]"></div>
                )}
                <img
                  src={cap.art.src}
                  alt=""
                  width={cap.art.width}
                  height={cap.art.height}
                  class:list={["max-w-none lg:absolute", cap.artClass]}
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-x-0 bottom-0 h-[45%] bg-linear-to-b from-[rgb(255_255_255_/_0)] to-white"></div>
              </div>
              <div class="relative flex flex-col gap-2 p-2">
                <h3 class="m-0 font-sans text-[18px] font-medium leading-[20.88px] text-ink">
                  {cap.title}
                </h3>
                <p class="m-0 max-w-[540px] font-sans text-base leading-[20.8px] text-ink-muted">
                  {cap.description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
