---
---

<section class="bg-white py-16 lg:py-[68px]" aria-labelledby="why-title" data-why>
  <div class="mx-auto max-w-[1440px] px-6 min-[1360px]:pr-6 min-[1360px]:pl-[120px]">
    <div
      class="mx-auto grid max-w-[619px] items-center gap-10 min-[1024px]:max-w-[1228px] min-[1024px]:grid-cols-[minmax(0,619fr)_minmax(0,568fr)] min-[1024px]:gap-[41px] min-[1360px]:mx-0"
    >
      <div data-why-art-wrap>
        <div
          class="relative flex aspect-[619/400] w-full items-center justify-center overflow-hidden bg-panel"
          data-why-art
        >
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgb(227_232_239/0.8)_0.625px,transparent_0.625px)] bg-[size:6.146px_6.146px] [background-position:3.125px_3.125px]"
          aria-hidden="true"
        >
        </div>
        <div class="pointer-events-none absolute inset-0 grid place-items-center" aria-hidden="true">
          <div data-why-parallax data-depth="8">
            <img
              src="/images/whyitmatters/halftone.webp"
              alt=""
              class="w-full"
              width="1238"
              height="558"
              loading="lazy"
              decoding="async"
              data-why-halftone
            />
          </div>
        </div>
        <div class="pointer-events-none absolute inset-0 grid place-items-center" aria-hidden="true">
          <div class="flex w-full justify-center" data-why-parallax data-depth="14">
            <img
              src="/images/whyitmatters/gradient.svg"
              alt=""
              class="w-[47.3%]"
              width="293"
              height="159"
              loading="lazy"
              decoding="async"
              data-why-glow
            />
          </div>
        </div>
        <div class="relative w-full" data-why-parallax data-depth="22">
          <img
            src="/images/whyitmatters/vector.svg"
            alt=""
            aria-hidden="true"
            class="relative mx-auto block w-[75.6%] max-w-full"
            width="468"
            height="294"
            loading="lazy"
            decoding="async"
            data-why-diagram
          />
        </div>
        </div>
      </div>

      <div class="flex flex-col items-start gap-4">
        <p
          class="inline-flex h-8 items-center gap-2 border border-border-badge bg-white px-[9px]"
          data-why-badge
        >
          <span class="size-2.5 bg-[#607AFF]" aria-hidden="true"></span>
          <span class="font-sans text-sm font-medium uppercase tracking-[0.28px] text-ink-muted">
            Why It Matters
          </span>
        </p>

        <div class="flex flex-col items-start gap-3">
          <h2
            id="why-title"
            class="max-w-[386px] font-display text-[42px] leading-[1.16] text-ink [font-weight:580] max-lg:text-[32px] max-lg:leading-[1.25] max-sm:text-[26px]"
            data-why-title
          >
            Why security needs to be continuous
          </h2>
          <p
            class="max-w-[481px] font-sans text-lg leading-[1.5] text-ink-muted max-sm:text-base"
            data-why-sub
          >
            Growing systems create new risks. Continuous security keeps them visible and under control.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
