---
// Geometry measured from the 1440×1024 reference (2880×2048 at 2×):
// card x442..997 (555 wide), y148..877, inputs x474..965, pitch 21.6px
// dot lattice with 12px dots behind a 3-stop vertical mask.
const providers = [
  {
    id: "google",
    icon: "/images/login/google.svg",
    iconWidth: 20,
    iconHeight: 21,
    label: ["Continue with ", "Google"],
  },
  {
    id: "github",
    icon: "/images/login/github.svg",
    iconWidth: 21,
    iconHeight: 20,
    label: ["Continue with ", "GitHub"],
  },
] as const;
---

<section class="login" data-login>
  <div class="login-pattern" aria-hidden="true" data-login-pattern></div>

  <div class="login-card" data-login-card>
    <div class="login-body">
      <header class="flex flex-col gap-8">
        <a href="/" class="flex min-h-8 items-center gap-[8.53px] no-underline" aria-label="Latch — home">
          <svg
            class="h-[27px] w-[25.6px] flex-none text-ink-strong"
            width="24"
            height="26"
            viewBox="0 0 24 26"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M6.61832 12.7385L9.70992 20.7455H4.14504L2.12977 15.4909H0L5.9542 0H11.5191L6.61832 12.7385Z"
              fill="currentColor"></path>
            <path
              d="M17.3817 12.7385L14.2901 4.73143H19.855L21.8702 9.98604H24L18.0458 25.4769H12.4809L17.3817 12.7385Z"
              fill="currentColor"></path>
          </svg>
          <span class="text-[25.6px] leading-none font-semibold tracking-tight text-ink">Latch</span>
        </a>

        <div class="flex flex-col gap-2">
          <h1
            class="m-0 font-display text-[clamp(28px,6vw,32px)] leading-[1.3] text-ink font-serif-display"
            data-login-title
          >
            Welcome back
          </h1>
          <p class="m-0 font-sans text-sm leading-[21px] text-ink-muted">
            Sign in to keep your applications, identities, and data protected.
          </p>
        </div>
      </header>

      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-[11px]">
          <div class="grid gap-[11px] sm:grid-cols-2">
            {
              providers.map((provider, index) => (
                <button
                  type="button"
                  class="login-oauth group"
                  data-login-oauth
                  data-login-index={index}
                >
                  <img
                    src={provider.icon}
                    alt=""
                    aria-hidden="true"
                    width={provider.iconWidth}
                    height={provider.iconHeight}
                    class="flex-none"
                    loading="eager"
                    decoding="async"
                  />
                  <span class="font-tight text-sm leading-[21px] text-ink">
                    {provider.label[0]}
                    <span class="font-semibold">{provider.label[1]}</span>
                  </span>
                </button>
              ))
            }
          </div>

          <button type="button" class="login-oauth group" data-login-oauth data-login-index="2">
            <img
              src="/images/login/sso.svg"
              alt=""
              aria-hidden="true"
              width="20"
              height="20"
              class="flex-none"
              loading="eager"
              decoding="async"
            />
            <span class="font-tight text-sm leading-[21px] text-ink">
              Single sign-on <span class="font-semibold">(SSO)</span>
            </span>
          </button>
        </div>

        <div class="flex items-center gap-3" aria-hidden="true">
          <span class="h-px flex-1 bg-border-badge"></span>
          <span class="font-tight text-xs leading-[18px] font-medium text-[#677489]">OR</span>
          <span class="h-px flex-1 bg-border-badge"></span>
        </div>

        <form class="flex flex-col gap-6" novalidate data-login-form>
          <div class="flex flex-col gap-4">
            <div class="flex flex-col gap-2">
              <label for="login-email" class="font-tight text-sm leading-[21px] font-medium text-ink">
                Email Address
              </label>
              <input
                id="login-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                required
                placeholder="Enter your email address"
                class="login-input"
                data-login-field
              />
            </div>

            <div class="flex flex-col gap-2">
              <div class="flex items-baseline justify-between gap-4">
                <label for="login-password" class="font-tight text-sm leading-[21px] font-medium text-ink">
                  Password
                </label>
                <a href="/forgot-password" class="login-link font-tight text-sm leading-[21px] font-medium">
                  Forgot Password ?
                </a>
              </div>

              <div class="relative">
                <input
                  id="login-password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  required
                  placeholder="Enter your email password"
                  class="login-input pr-12"
                  data-login-field
                />
                <button
                  type="button"
                  class="absolute inset-y-0 right-4 grid place-items-center text-ink-muted transition-colors duration-200 hover:text-ink"
                  aria-label="Show password"
                  aria-pressed="false"
                  data-login-reveal
                >
                  <img
                    src="/images/login/eye.svg"
                    alt=""
                    aria-hidden="true"
                    width="20"
                    height="20"
                    class="size-5"
                    decoding="async"
                  />
                </button>
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-3">
            <button type="submit" class="login-submit" data-login-submit data-cta-scale>
              Sign in
            </button>
            <p class="m-0 flex flex-wrap items-center justify-center gap-2 text-center font-tight text-sm leading-[21px]">
              <span class="text-ink font-medium">New to latch ?</span>
              <a href="/signup" class="login-link font-medium">Create an account</a>
            </p>
          </div>
        </form>
      </div>
    </div>

    <div class="login-strip">
      <img
        src="/images/login/shield-tick.svg"
        alt=""
        aria-hidden="true"
        width="13"
        height="13"
        class="size-[13px] flex-none"
        decoding="async"
      />
      <p class="m-0 font-sans text-[10px] leading-[15px] text-hero-badge-ink">
        Protected by <span class="font-semibold">Latch</span> - SOC 2 Type II End-to-end encrypted
      </p>
    </div>
  </div>
</section>

<style>
  .login {
    position: relative;
    isolation: isolate;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 4vw, 48px) clamp(16px, 4vw, 32px);
    background: var(--color-hero-bg);
    overflow: hidden;
  }

  /* 21.6px pitch, 12px dots. Ink and ramp measured from the reference: peak
     dots read rgb(221 229 250) at y860 and the lattice is gone by y1010. */
  .login-pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(circle at center, rgb(225 232 251) 0 6px, rgb(225 232 251 / 0) 6.4px);
    background-size: 21.6px 21.6px;
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      transparent 58%,
      rgb(0 0 0 / 0.1) 58.6%,
      rgb(0 0 0 / 0.29) 62.5%,
      rgb(0 0 0 / 0.39) 66.4%,
      rgb(0 0 0 / 0.46) 70.3%,
      rgb(0 0 0 / 0.6) 74.2%,
      rgb(0 0 0 / 0.76) 78.1%,
      rgb(0 0 0 / 0.97) 82%,
      #000 84%,
      rgb(0 0 0 / 0.87) 85.9%,
      rgb(0 0 0 / 0.68) 89.8%,
      rgb(0 0 0 / 0.45) 93.8%,
      rgb(0 0 0 / 0.21) 97.7%,
      rgb(0 0 0 / 0.1) 100%
    );
  }

  .login-card {
    width: min(555px, 100%);
    background: var(--color-surface);
    box-shadow:
      0 10px 16px -4px rgb(16 24 40 / 0.04),
      0 8px 8px -4px rgb(16 24 40 / 0.04);
  }

  .login-body {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 24px 32px 40px;
  }

  .login-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 4px 16px 4px;
    background: var(--color-hero-badge);
  }

  .login-oauth {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding-inline: 16px;
    border: 1px solid var(--color-border-badge);
    border-radius: 8px;
    background: var(--color-surface);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .login-oauth:hover {
    border-color: #cdd5e0;
    box-shadow: 0 1px 2px rgb(16 24 40 / 0.05);
  }

  .login-oauth:active {
    background: #f8fafc;
  }

  .login-input {
    width: 100%;
    height: 48px;
    padding-inline: 16px;
    border: 1px solid var(--color-border-badge);
    border-radius: 8px;
    background: var(--color-surface);
    font-family: var(--font-tight);
    font-size: 14px;
    line-height: 21px;
    color: var(--color-ink);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .login-input::placeholder {
    color: #97a3b6;
  }

  .login-input:hover {
    border-color: #cdd5e0;
  }

  .login-input:focus {
    outline: none;
    border-color: var(--color-brand-500);
    box-shadow: 0 0 0 3px rgb(94 118 255 / 0.16);
  }

  .login-link {
    color: #5e71ff;
    text-decoration: none;
    border-radius: 2px;
    transition: color 0.2s ease;
  }

  .login-link:hover {
    color: var(--color-brand-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The reference gradient mid-stop sits at y750, near the 30% mark of the
     50px button, hence the explicit stop below the default 50%. */
  .login-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    border: 1px solid #758cfd;
    border-radius: 8px;
    background-image: linear-gradient(180deg, #5e76ff 0%, #70a9fe 100%);
    box-shadow:
      0 4px 4px #cecfd3,
      0 0 0 1px rgb(90 120 255 / 0.2);
    color: #f8fafc;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    text-shadow: 0 2px 4px #4785f0;
    cursor: pointer;
    transition: filter 0.15s ease;
  }

  .login-submit:hover {
    filter: brightness(1.05);
  }

  .login-submit:active {
    filter: brightness(0.97);
  }

  .login-submit[aria-busy="true"] {
    cursor: progress;
    filter: saturate(0.6);
  }

  @media (max-width: 639px) {
    .login-body {
      gap: 32px;
      padding: 20px 20px 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .login-oauth,
    .login-input,
    .login-link,
    .login-submit {
      transition: none;
    }
  }
</style>

<script>
  const reveal = document.querySelector<HTMLButtonElement>("[data-login-reveal]");
  const password = document.querySelector<HTMLInputElement>("#login-password");

  if (reveal && password) {
    reveal.addEventListener("click", () => {
      const shown = password.type === "text";
      password.type = shown ? "password" : "text";
      reveal.setAttribute("aria-pressed", String(!shown));
      reveal.setAttribute("aria-label", shown ? "Show password" : "Hide password");
    });
  }
</script>
