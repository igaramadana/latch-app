---
interface Role {
  title: string;
  href: string;
}

interface Group {
  key: string;
  label: string;
  blurb: string;
  roles: Role[];
}

// Copy is verbatim from the design. Every role shares the same location and
// contract type, so they are declared once instead of repeated per row.
const LOCATION = "United States";
const CONTRACT = "Full-Time";

const groups: Group[] = [
  {
    key: "technology",
    label: "Technology",
    blurb: "Build the engine behind security.",
    roles: [
      { title: "Senior Backend Engineer", href: "#senior-backend-engineer" },
      { title: "API Platform Engineer", href: "#api-platform-engineer" },
      { title: "Cloud Infrastructure Engineer", href: "#cloud-infrastructure-engineer" },
    ],
  },
  {
    key: "marketing",
    label: "Marketing",
    blurb: "Bring Latch's mission to the world.",
    roles: [
      { title: "Content Strategist", href: "#content-strategist" },
      { title: "Growth Marketing Lead", href: "#growth-marketing-lead" },
      { title: "Demand Generation Specialist", href: "#demand-generation-specialist" },
    ],
  },
];
---

<section
  class="bg-white pt-[clamp(64px,7vw,100px)] pb-[clamp(64px,7vw,94px)]"
  aria-labelledby="careers-roles-title"
  data-roles
>
  <div class="mx-auto w-full max-w-[1440px] px-6 md:px-8 lg:px-[212px]">
    <header class="flex flex-col items-center gap-4 text-center">
      <p
        class="inline-flex h-8 items-center gap-2 border border-border-badge bg-white px-[9px]"
        data-roles-badge
      >
        <span class="size-2.5 flex-none bg-[#607AFF]" aria-hidden="true"></span>
        <span class="font-sans text-sm font-medium uppercase tracking-[0.28px] text-ink-muted">
          Career
        </span>
      </p>

      <div class="flex flex-col items-center gap-3">
        <h2
          id="careers-roles-title"
          class="m-0 font-display text-[clamp(28px,3.4vw,42px)] leading-[1.16] tracking-normal text-ink font-mix-medium max-sm:text-[26px]"
          data-roles-title
        >
          Exciting Roles
        </h2>
        <p
          class="m-0 max-w-[788px] font-sans text-[20px] leading-[26px] text-pretty text-ink-muted max-sm:text-base max-sm:leading-6"
          data-roles-sub
        >
          Join a team where your ideas shape what we build.
        </p>
      </div>
    </header>

    <div class="mt-[clamp(40px,3.6vw,49px)]">
      {
        groups.map((group, groupIndex) => (
          <div
            class:list={[
              "border-t border-border-badge",
              groupIndex === groups.length - 1 && "border-b",
            ]}
            data-roles-group
          >
            <div class="flex flex-col lg:flex-row lg:gap-8">
              <div class="w-full shrink-0 pt-6 pb-2 lg:w-[288px] lg:pt-[39px] lg:pb-0">
                <h3 class="m-0 font-sans text-lg font-semibold leading-[27px] text-ink">
                  {group.label}
                </h3>
                <p class="m-0 mt-1 font-sans text-sm leading-[21px] text-ink-muted">
                  {group.blurb}
                </p>
              </div>

              <ul class="m-0 flex w-full list-none flex-col p-0 lg:w-[696px] lg:flex-none">
                {group.roles.map((role, roleIndex) => (
                  <li
                    class:list={[
                      "grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3 py-5 sm:flex sm:items-center sm:gap-6 lg:h-[100px] lg:py-0 lg:gap-16",
                      roleIndex < group.roles.length - 1 && "lg:border-b lg:border-border-badge",
                    ]}
                    data-roles-row
                  >
                    <a
                      href={role.href}
                      class="group order-1 flex min-w-0 items-center no-underline sm:order-none sm:flex-1"
                    >
                      <span class="font-sans text-base font-medium leading-6 text-ink transition-colors duration-200 group-hover:text-brand-600">
                        {role.title}
                      </span>
                    </a>

                    <div class="order-3 col-span-2 flex w-fit items-center gap-2 rounded-lg bg-hero-bg px-3 py-[7.5px] sm:order-none sm:col-auto sm:w-auto">
                      <img
                        src="/images/careers/career/globe.svg"
                        alt=""
                        aria-hidden="true"
                        width="18"
                        height="18"
                        class="size-[18px] flex-none"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="font-sans text-sm font-medium leading-[21px] text-[#677489]">
                        {LOCATION}
                      </span>
                      <span class="font-sans text-sm font-medium leading-[21px] text-[#CDD5E0]" aria-hidden="true">
                        ·
                      </span>
                      <img
                        src="/images/careers/career/Clock.svg"
                        alt=""
                        aria-hidden="true"
                        width="18"
                        height="18"
                        class="size-[18px] flex-none"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="font-sans text-sm font-medium leading-[21px] text-[#677489]">
                        {CONTRACT}
                      </span>
                    </div>

                    <a
                      href={role.href}
                      class="order-2 grid size-9 shrink-0 place-items-center justify-self-end rounded-lg border border-border-badge lg:h-9 lg:w-11 bg-white shadow-[0_1px_2px_-3px_rgb(0_0_0/0.03)] transition-colors duration-200 hover:border-[#CDD5E0] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 sm:order-none"
                      aria-label={`View ${role.title}`}
                      data-roles-arrow
                    >
                      <img
                        src="/images/careers/career/ArrowUpRight.svg"
                        alt=""
                        aria-hidden="true"
                        width="18"
                        height="18"
                        class="size-[18px]"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }

      <div
        class="mt-6 flex flex-col items-center gap-4 text-center sm:items-start sm:text-left lg:mt-[26px] lg:flex-row lg:items-center lg:justify-between"
        data-roles-footer
      >
        <p class="m-0 font-sans text-base leading-6 text-ink-muted">
          Grow your career while securing the world's systems.
        </p>
        <a
          href="#open-roles"
          class="inline-flex w-full items-center justify-center gap-1.5 rounded-full border border-[#758CFD] bg-linear-to-b from-[#5E76FF] from-[6.579%] to-[#70A9FE] px-4 py-2.5 font-sans text-sm leading-[18px] font-medium whitespace-nowrap text-[#F8FAFC] no-underline shadow-cta [text-shadow:0_2px_4px_#4785f0] transition-[filter] duration-150 hover:brightness-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 sm:w-auto"
          data-roles-cta
          data-cta-scale
        >
          Explore All Roles
        </a>
      </div>
    </div>
  </div>
</section>
