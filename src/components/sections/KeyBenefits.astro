---
interface Benefit {
  index: string;
  icon: string;
  title: string;
  description?: string;
}

const benefits: Benefit[] = [
  {
    index: "01",
    icon: "/images/platforms/key-benefits/clock-stopwatch.svg",
    title: "Real-time, not point-in-time",
    description:
      "Catch risk the moment it appears instead of weeks later at the next scan.",
  },
  {
    index: "02",
    icon: "/images/platforms/key-benefits/eye.svg",
    title: "No blind spots",
  },
  {
    index: "03",
    icon: "/images/platforms/key-benefits/flash.svg",
    title: "Faster response",
  },
  {
    index: "04",
    icon: "/images/platforms/key-benefits/dataflow-04.svg",
    title: "Lightweight setup",
  },
];
---

<section
  class="bg-white py-16 lg:pt-[100px] lg:pb-[229px]"
  aria-labelledby="key-benefits-title"
  data-key-benefits
>
  <div class="mx-auto max-w-[1440px] px-6 lg:px-[120px]">
    <div class="flex flex-col gap-16">
      <header class="flex flex-col items-start gap-4">
        <p
          class="inline-flex h-8 items-center gap-2 border border-border-badge bg-white px-[9px]"
          data-kb-badge
        >
          <span class="size-2.5 bg-[#607AFF]" aria-hidden="true"></span>
          <span class="font-sans text-sm font-medium uppercase tracking-[0.28px] text-ink-muted">
            Key Benefits
          </span>
        </p>
        <div class="flex flex-col items-start gap-3">
          <h2
            id="key-benefits-title"
            class="font-display text-[42px] leading-[1.16] tracking-normal text-ink font-mix-medium max-lg:text-[32px] max-lg:leading-[1.25] max-sm:text-[26px]"
            data-kb-title
          >
            Why teams move to Latch
          </h2>
          <p
            class="font-sans text-[20px] leading-[1.3] text-pretty text-ink-muted max-sm:text-base"
            data-kb-sub
          >
            Security designed to keep up with your real-world development and
            deployment processes.
          </p>
        </div>
      </header>

      <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-8">
        <div
          class="mx-auto flex aspect-[457/422] w-full max-w-[457px] items-center justify-center overflow-hidden bg-panel lg:mx-0 lg:w-[457px] lg:flex-none"
          data-kb-art
        >
          <img
            src="/images/platforms/key-benefits/illustration.svg"
            alt=""
            aria-hidden="true"
            width="327"
            height="321"
            class="w-[71.5%] max-w-none lg:ml-[22px]"
            loading="lazy"
            decoding="async"
          />
        </div>

        <ul class="m-0 flex w-full list-none flex-col p-0 lg:w-[662px] lg:flex-none">
          {
            benefits.map((benefit) => (
              <li
                class="group flex flex-col gap-3 py-7 shadow-[0_1px_0_0_#E3E8EF]"
                data-kb-item
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-start gap-3">
                    <img
                      src={benefit.icon}
                      alt=""
                      aria-hidden="true"
                      width="24"
                      height="24"
                      class="size-6 flex-none"
                      loading="lazy"
                      decoding="async"
                    />
                    <h3 class="m-0 font-sans text-[20px] font-medium leading-[23.2px] text-ink">
                      {benefit.title}
                    </h3>
                  </div>
                  <p
                    class:list={[
                      "m-0 flex flex-none items-center gap-1.5 px-[9px] font-mono text-sm font-medium uppercase leading-[16.8px] tracking-[0.28px]",
                      benefit.description ? "text-ink" : "text-[#97A3B6]",
                    ]}
                  >
                    <span
                      class:list={[
                        "size-2",
                        benefit.description ? "bg-ink" : "bg-[#CDD5E0]",
                      ]}
                      aria-hidden="true"
                    />
                    {benefit.index}
                  </p>
                </div>
                <p class="m-0 max-w-[485px] font-sans text-lg leading-[27px] text-ink-muted">
                  {benefit.description ?? ""}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
