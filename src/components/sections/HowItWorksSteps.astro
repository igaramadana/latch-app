---
interface Step {
  icon: string;
  title: string;
  description: string;
}

const steps: Step[] = [
  {
    icon: "/images/platforms/how-it-works/PlugsConnected.svg",
    title: "Connect",
    description:
      "Easily connect your entire technology stack using APIs and OAuth within minutes — no need to deploy any agents across your systems.",
  },
  {
    icon: "/images/platforms/how-it-works/file-search-01.svg",
    title: "Monitor",
    description:
      "Perform continuous, real-time testing of your applications, APIs, user identities, and infrastructure to ensure ongoing security and performance.",
  },
  {
    icon: "/images/platforms/how-it-works/mark.svg",
    title: "Detect",
    description:
      "Advanced AI models detect and prioritize unusual behaviors early, helping to prevent security breaches before they occur.",
  },
  {
    icon: "/images/platforms/how-it-works/check-circle.svg",
    title: "Respond",
    description:
      "Automated runbooks immediately contain threats and initiate remediation processes as soon as a risk is identified and confirmed.",
  },
];
---

<section
  class="relative bg-white"
  aria-labelledby="how-it-works-title"
  data-hiw
>
  <div class="hiw-track relative" data-hiw-track>
    <div
      class="hiw-stage flex min-h-svh flex-col items-center justify-start pt-[clamp(40px,8.8vh,100px)] pb-[clamp(24px,6vh,70px)]"
      data-hiw-stage
    >
      <div class="flex w-full max-w-[1440px] flex-1 flex-col px-6 lg:px-[120px]">
        <div
          class="hiw-inner mx-auto flex w-full max-w-[1200px] flex-1 flex-col items-center gap-[clamp(24px,5.6vh,64px)]"
        >
          <header class="flex w-full max-w-[738px] flex-col items-center gap-4 text-center">
            <p
              class="inline-flex h-8 items-center gap-2 border border-border-badge bg-white px-[9px]"
              data-hiw-badge
            >
              <span class="size-2.5 bg-[#607AFF]" aria-hidden="true"></span>
              <span class="font-sans text-sm font-medium uppercase tracking-[0.28px] text-ink-muted">
                How it works
              </span>
            </p>
            <div class="flex flex-col items-center gap-3">
              <h2
                id="how-it-works-title"
                class="font-display text-[42px] leading-[1.16] tracking-normal text-ink font-mix-medium max-lg:text-[32px] max-lg:leading-[1.25] max-sm:text-[26px]"
                data-hiw-title
              >
                Security that works the way you do
              </h2>
              <p
                class="max-w-[540px] font-sans text-[20px] leading-[1.3] text-pretty text-ink-muted max-sm:text-base"
                data-hiw-sub
              >
                Connect your security stack, surface what matters, and act on
                threats faster.
              </p>
            </div>
          </header>

          <div class="hiw-steps relative flex w-full max-w-[648px] flex-col">
            <div
              class="hiw-line absolute top-12 bottom-12 left-6 -ml-px w-px bg-[#E3E8EF] sm:top-16 sm:bottom-16 sm:left-8"
              aria-hidden="true"
            >
              <div
                class="absolute left-0 w-full bg-[linear-gradient(to_bottom,rgb(94_113_255_/_0)_0%,#5E71FF_14%,#5E71FF_86%,rgb(94_113_255_/_0)_100%)]"
                data-hiw-line-fill
              ></div>
            </div>

            <ol
              class="hiw-steps__list m-0 flex list-none flex-col gap-10 p-0"
              data-hiw-list
            >
              {
                steps.map((step, index) => (
                  <li
                    class="grid grid-cols-[48px_minmax(0,1fr)] items-start gap-4 sm:grid-cols-[64px_minmax(0,520px)] sm:gap-16"
                    data-hiw-step
                  >
                    <span
                      class="hiw-node relative block size-12 shrink-0 rounded-full bg-[#E3E8EF] sm:size-16"
                      data-hiw-node
                    >
                      <span class="hiw-node__ring" aria-hidden="true" />
                      <span class="hiw-node__knob">
                        <span class="font-sans text-sm font-semibold leading-[21px] text-ink">
                          {String(index + 1).padStart(2, "0")}
                        </span>
                      </span>
                    </span>

                    <div class="flex flex-col gap-3" data-hiw-copy>
                      <div class="flex items-center gap-3">
                        <span
                          class="hiw-icon relative block size-6 shrink-0"
                          style={`--hiw-icon: url("${step.icon}")`}
                          aria-hidden="true"
                        >
                          <span class="absolute inset-0 bg-[#CDD5E0]" />
                          <span
                            class="absolute inset-0 bg-linear-to-b from-[#607AFF] to-[#6C9FFE] opacity-0"
                            data-hiw-icon-active
                          />
                        </span>
                        <h3 class="m-0 font-sans text-[20px] font-medium leading-[23.2px] text-ink">
                          {step.title}
                        </h3>
                      </div>
                      <p class="m-0 font-sans text-base leading-6 text-ink-muted">
                        {step.description}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ol>

            <div class="hiw-fade pointer-events-none absolute inset-0" aria-hidden="true" data-hiw-fade></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hiw-icon {
    mask-image: var(--hiw-icon);
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
  }

  /* Figma's white gradient over the lower half of the list, but its start point
     follows the active step so the step being read is never washed out. */
  .hiw-steps {
    --hiw-fade: 34;
  }

  .hiw-fade {
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0) calc(var(--hiw-fade, 34) * 1%),
      #fff 108%
    );
  }

  .hiw-node__ring {
    position: absolute;
    inset: 4px;
    border-radius: 9999px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.5));
    box-shadow:
      inset -3.2px -3.2px 3.2px rgb(255 255 255 / 0.1),
      inset 3.2px 3.2px 3.2px rgb(0 93 187 / 0.2);
  }

  .hiw-node__ring::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1.6px solid rgb(255 255 255 / 0.5);
  }

  .hiw-node__knob {
    position: absolute;
    inset: 8px;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    background: linear-gradient(180deg, #fff, rgb(255 255 255 / 0.6));
    outline: 1px solid #fff;
    outline-offset: -1px;
    box-shadow:
      0 0 0 1px rgb(23 23 23 / 0.02),
      0 1px 1px -0.5px rgb(23 23 23 / 0.06),
      0 3px 3px -1.5px rgb(23 23 23 / 0.06),
      0 6px 6px -3px rgb(23 23 23 / 0.12);
  }

  @media (min-width: 1025px) {
    .hiw-stage {
      padding-top: clamp(88px, 8.8vh, 100px);
    }
  }

  @media (min-width: 1025px) and (min-height: 740px) {
    .hiw-track {
      --hiw-lead: clamp(0px, calc((100svh - 820px) * 0.4), 48px);

      height: 500svh;
    }

    .hiw-stage {
      position: sticky;
      inset-block-start: 0;
      height: 100svh;
      min-height: 0;
      padding-top: clamp(88px, calc((100svh - 680px) * 0.22), 100px);
      padding-bottom: clamp(16px, calc((100svh - 680px) * 0.154), 70px);
    }

    .hiw-inner {
      gap: clamp(16px, calc((100svh - 680px) * 0.141), 64px);
    }

    .hiw-steps {
      flex: 1 1 0;
      min-height: 0;
      max-height: 713px;
    }

    .hiw-steps__list {
      flex: 1 1 0;
      min-height: 0;
      display: grid;
      /* Figma's own rhythm: the three gaps are 190 / 198 / 194 tall, not equal
         because the rows were placed by hand. fr keeps the ratio at any height. */
      grid-template-rows: 190fr 198fr 194fr auto;
      gap: 0;
      padding-top: var(--hiw-lead);
    }

    .hiw-line {
      top: calc(64px + var(--hiw-lead));
      bottom: 84px;
    }
  }
</style>
