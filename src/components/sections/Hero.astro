---
import CtaButton from "../CtaButton.astro";

const ctas = [
  { label: "Start for free", href: "/signup", variant: "primary" as const },
  { label: "Book a demo", href: "/contact", variant: "secondary" as const },
];

const announcements = {
  badge: "News",
  text: "Security that runs as your system runs",
};
---

<section class="relative isolate overflow-hidden bg-hero-bg" aria-labelledby="hero-title" data-hero>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-x-0 bottom-0 h-[551px]" data-hero-pattern>
      <picture>
        <source srcset="/images/hero/pattern-mirror.webp" type="image/webp" />
        <img
          class="absolute inset-0 h-full w-full object-cover object-top opacity-70"
          src="/images/hero/pattern-mirror.jpg"
          alt=""
          width="1440"
          height="551"
          loading="eager"
          decoding="async"
          fetchpriority="low"
        />
      </picture>

      <div
        class="absolute inset-x-0 top-0 h-[266px] bg-linear-to-b from-hero-bg to-[rgb(241_246_253_/_0)]"
      >
      </div>
    </div>

    <div
      class="absolute inset-x-0 bottom-0 h-[674px] bg-linear-to-b from-[rgb(241_246_253_/_0)] to-hero-bg"
    >
    </div>
  </div>

  <div
    class="relative mx-auto max-w-[1440px] px-6 pt-[calc(var(--spacing-nav)+150px)] pb-16 lg:pt-[calc(var(--spacing-nav)+118px)] lg:pb-0"
  >
    <div class="mx-auto flex max-w-[840px] flex-col items-center gap-8 text-center">
      <div class="flex flex-col items-center gap-6">
        <div
          class="inline-flex flex-wrap items-center justify-center gap-3"
          data-hero-badge
        >
          <span
            class="inline-flex h-6 items-center justify-center rounded-sm bg-hero-badge px-2 font-sans text-[12.9px] font-medium uppercase leading-[18.4px] text-hero-badge-ink"
          >
            {announcements.badge}
          </span>
          <span class="font-sans text-sm font-medium leading-[22.5px] text-balance text-black">
            {announcements.text}
          </span>
        </div>

        <h1
          id="hero-title"
          class="font-display text-[72px] leading-[1.2] text-balance text-ink max-lg:text-[60px] max-md:text-[48px] max-sm:text-[36px] font-mix-medium"
          data-hero-title
        >
          Proven Security SaaS<br />
          Data Security
        </h1>
      </div>

      <p
        class="max-w-[532px] font-sans text-[20px] leading-[1.5] text-pretty text-ink-muted max-sm:text-base"
        data-hero-sub
      >
        Secure applications, identities, and data with continuous testing and
        identity-aware protection.
      </p>

      <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-[11px] p-0 max-sm:w-full max-sm:flex-col">
        {
          ctas.map((cta) => (
            <li class="max-sm:w-full">
              <CtaButton
                href={cta.href}
                variant={cta.variant}
                class="max-sm:w-full"
                data-hero-cta
              >
                {cta.label}
              </CtaButton>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div
    class="relative mx-auto mt-4 max-w-[1440px] overflow-hidden sm:mt-6 [@media(width>=1025px)]:mt-6 [@media(width>=1025px)]:h-[729px]"
    data-hero-art
  >
    <div class="relative mx-auto w-full max-w-[1329px]">
      <img
        class="block w-full"
        src="/images/hero/isometric-fresh.svg"
        alt="Latch security platform shown as an isometric diagram of connected services"
        width="1329"
        height="1108"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <div
      class="pointer-events-none absolute inset-0 mx-auto max-w-[1329px]"
      data-hero-cards
    >
      <img
        class="absolute left-[18.6%] top-[18.5%] w-[20.5%] [@media(width>=1025px)]:top-[28.1%]"
        src="/images/hero/card-left.svg"
        alt=""
        aria-hidden="true"
        decoding="async"
        width="273"
        height="237"
        data-hero-card="left"
      />
      <img
        class="absolute left-[62.8%] top-[18.5%] w-[20.5%] [@media(width>=1025px)]:top-[28.1%]"
        src="/images/hero/card-right.svg"
        alt=""
        aria-hidden="true"
        decoding="async"
        width="273"
        height="237"
        data-hero-card="right"
      />
      <img
        class="absolute left-[82.3%] top-[39.8%] w-[17.7%] [@media(width>=1025px)]:top-[60.4%]"
        src="/images/hero/card-far.svg"
        alt=""
        aria-hidden="true"
        decoding="async"
        width="235"
        height="266"
        data-hero-card="far"
      />
      <img
        class="absolute left-[13.3%] top-[52.2%] w-[20.5%] [@media(width>=1025px)]:top-[79.3%]"
        src="/images/hero/card-left.svg"
        alt=""
        aria-hidden="true"
        decoding="async"
        width="273"
        height="237"
        data-hero-card="lower-left"
      />
      <img
        class="absolute left-[64.6%] top-[51.4%] w-[20.5%] [@media(width>=1025px)]:top-[78.1%]"
        src="/images/hero/card-right.svg"
        alt=""
        aria-hidden="true"
        decoding="async"
        width="273"
        height="237"
        data-hero-card="lower-right"
      />
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[186px] bg-linear-to-b from-[rgb(241_246_253_/_0)] to-hero-bg"
    aria-hidden="true"
  >
  </div>
</section>
