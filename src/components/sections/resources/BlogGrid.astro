---
import { posts, filters, categoryById } from "../../../lib/blog-data";

/** One grid page matches all 9 articles by default. */
const PAGE_SIZE = 9;
---

<section class="bg-white pb-10" aria-labelledby="resources-blog-title" data-res-blog>
  <div class="mx-auto w-full max-w-[1440px] px-6 md:px-10 lg:px-[82px]">
    <h2 id="resources-blog-title" class="sr-only">Guides and articles</h2>

    <div class="flex flex-col gap-8">
      <div
        class="-mx-6 overflow-x-auto px-6 md:-mx-10 md:px-10 lg:mx-0 lg:px-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        <div
          class="relative inline-flex min-w-max items-center gap-1 lg:flex lg:min-w-0 lg:flex-wrap"
          role="group"
          aria-label="Filter articles by category"
          data-blog-tabs
        >
          <span
            class="pointer-events-none absolute top-0 left-0 h-10 rounded-lg border border-[#DCE5FF] bg-[#EEF2FF] opacity-0"
            aria-hidden="true"
            data-blog-tab-indicator
          ></span>

          {
            filters.map((filter) => (
              <button
                type="button"
                class="relative z-10 h-10 shrink-0 cursor-pointer appearance-none rounded-lg px-4 font-tight text-base font-medium leading-6 text-[#666D80] transition-colors duration-200 hover:text-ink aria-pressed:text-[#5F77FF]"
                aria-pressed={filter.id === "all" ? "true" : "false"}
                data-blog-tab
                data-filter={filter.id}
              >
                {filter.label}
              </button>
            ))
          }
        </div>
      </div>

      <p class="sr-only" role="status" aria-live="polite" data-blog-status></p>

      <div
        class="relative grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
        data-blog-grid
        data-page-size={PAGE_SIZE}
      >
        {
          posts.map((post) => {
            const category = categoryById.get(post.category)!;
            const heading = `blog-title-${post.slug}`;
            return (
              <article
                class="flex flex-col self-stretch will-change-[transform,opacity]"
                aria-labelledby={heading}
                data-blog-card
                data-category={post.category}
                data-search={`${post.title} ${post.excerpt} ${post.author} ${category.label}`.toLowerCase()}
              >
                <a
                  href={`/resources/${post.slug}`}
                  class="group flex flex-1 flex-col gap-4 border border-[#F1F4F8] bg-white p-4 no-underline shadow-[0_1px_2px_rgb(13_13_18/0.04),0_1px_3px_rgb(13_13_18/0.05)] transition-[box-shadow,transform,border-color] duration-300 ease-out hover:-translate-y-1 hover:border-[#DCE5FF] hover:shadow-[0_2px_6px_rgb(13_13_18/0.05),0_14px_30px_rgb(13_13_18/0.09)] motion-reduce:transition-none"
                >
                  <span class="overflow-hidden">
                    <img
                      class="aspect-[377/224] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                      src={`${post.image}-755.webp`}
                      srcset={`${post.image}-377.webp 377w, ${post.image}-755.webp 755w`}
                      sizes="(min-width: 1025px) 380px, (min-width: 640px) 46vw, 88vw"
                      alt={post.alt}
                      width="755"
                      height="448"
                      loading="lazy"
                      decoding="async"
                      transition:name={`blog-image-${post.slug}`}
                    />
                  </span>

                  <div class="flex flex-1 flex-col justify-between gap-6 p-3">
                    <div class="flex flex-col gap-2">
                      <div class="flex items-center justify-between gap-2">
                        <span
                          class="inline-flex h-[26px] w-fit items-center rounded-md px-2.5 font-tight text-xs font-medium leading-[19.2px]"
                          style={`color:${category.fg};background:${category.bg}`}
                        >
                          {category.label}
                        </span>
                        <span class="font-tight text-xs font-medium text-[#666D80]">
                          {post.readTime}
                        </span>
                      </div>
                      <h3
                        id={heading}
                        class="m-0 text-pretty font-tight text-[24px] font-medium leading-[31.2px] tracking-normal text-[#0D0D12] transition-colors duration-200 group-hover:text-brand-600"
                      >
                        {post.title}
                      </h3>
                      <p class="m-0 text-pretty font-tight text-sm font-normal leading-[22.4px] text-[#666D80]">
                        {post.excerpt}
                      </p>
                    </div>

                    <div class="flex items-center justify-between gap-2.5">
                      <div class="flex items-center gap-2.5">
                        <img
                          class="size-8 shrink-0 rounded-full object-cover"
                          src={post.avatar}
                          alt=""
                          aria-hidden="true"
                          width="64"
                          height="64"
                          loading="lazy"
                          decoding="async"
                        />
                        <div class="flex flex-col">
                          <span class="font-tight text-sm font-medium leading-[22.4px] text-[#0D0D12]">
                            {post.author}
                          </span>
                          <time
                            class="font-tight text-xs font-medium leading-[19.2px] text-[#666D80]"
                            datetime={post.iso}
                          >
                            {post.date}
                          </time>
                        </div>
                      </div>

                      <span
                        class="inline-flex items-center gap-1 font-tight text-xs font-medium text-brand-600 opacity-0 transition-[opacity,transform] duration-200 group-hover:translate-x-0.5 group-hover:opacity-100"
                        aria-hidden="true"
                      >
                        Read →
                      </span>
                    </div>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>

      <p class="m-0 py-10 text-center font-tight text-base leading-6 text-[#666D80]" hidden data-blog-empty>
        No articles in this category yet.
      </p>

      <nav
        class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 py-4"
        aria-label="Article pages"
        data-blog-pager
      >
        <button
          type="button"
          class="blog-pager-arrow flex w-fit cursor-pointer items-center gap-0.5 border-0 bg-transparent p-0 font-tight text-base leading-6 text-ink"
          data-blog-prev
        >
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="size-4">
            <path
              d="M10 3 5 8l5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span class="max-[359px]:sr-only">Previous</span>
        </button>

        <ol class="m-0 flex list-none items-center gap-2 p-0" data-blog-pages></ol>

        <button
          type="button"
          class="blog-pager-arrow ml-auto flex w-fit cursor-pointer items-center gap-0.5 border-0 bg-transparent p-0 font-tight text-base leading-6 text-ink"
          data-blog-next
        >
          <span class="max-[359px]:sr-only">Next</span>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="size-4">
            <path
              d="M6 3l5 5-5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </nav>
    </div>
  </div>

  <template data-blog-page-tpl>
    <li>
      <button
        type="button"
        class="blog-page grid h-9 w-9 cursor-pointer place-items-center rounded-lg bg-white font-tight text-base leading-6 text-[#677489] transition-colors duration-200 hover:bg-[#F8FAFC] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      ></button>
    </li>
  </template>
</section>

<style is:global>
  /* Pager buttons are cloned from a template, so their rules cannot live in a
     scoped style block. Everything here is namespaced with `blog-`. */
  .blog-page[aria-current="page"] {
    background: linear-gradient(180deg, #5e77ff 0%, #6fa5fe 100%);
    color: #eff0ff;
  }

  .blog-page[aria-current="page"]:hover {
    background: linear-gradient(180deg, #5e77ff 0%, #6fa5fe 100%);
  }

  .blog-pager-arrow:disabled {
    color: #97a3b6;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-page,
    .blog-pager-arrow {
      transition: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { Flip } from "gsap/Flip";

  gsap.registerPlugin(Flip);

  function initBlogGrid() {
    const root = document.querySelector<HTMLElement>("[data-res-blog]");
    if (!root || root.dataset.blogInit === "true") return;
    root.dataset.blogInit = "true";

    const tabsWrap = root.querySelector<HTMLElement>("[data-blog-tabs]");
    const indicator = root.querySelector<HTMLElement>("[data-blog-tab-indicator]");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-blog-tab]"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-blog-card]"));
    const grid = root.querySelector<HTMLElement>("[data-blog-grid]");
    const status = root.querySelector<HTMLElement>("[data-blog-status]");
    const empty = root.querySelector<HTMLElement>("[data-blog-empty]");
    const pager = root.querySelector<HTMLElement>("[data-blog-pager]");
    const pageList = root.querySelector<HTMLOListElement>("[data-blog-pages]");
    const pageTpl = root.querySelector<HTMLTemplateElement>("[data-blog-page-tpl]");
    const prev = root.querySelector<HTMLButtonElement>("[data-blog-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-blog-next]");
    const searchInput = document.querySelector<HTMLInputElement>("#resources-search");
    const searchForm = searchInput?.closest("form");

    const pageSize = Number(grid?.dataset.pageSize) || 9;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let filter = "all";
    let query = "";
    let page = 1;
    let activeAnim: gsap.core.Animation | null = null;
    let heightTween: gsap.core.Tween | null = null;

    const moveIndicator = (target: HTMLButtonElement | undefined, immediate = false) => {
      if (!indicator || !tabsWrap || !target) return;
      const x = target.offsetLeft;
      const y = target.offsetTop;
      const width = target.offsetWidth;
      const height = target.offsetHeight;

      if (immediate || reduced) {
        gsap.set(indicator, { x, y, width, height, autoAlpha: 1, force3D: true });
        return;
      }

      gsap.to(indicator, {
        x,
        y,
        width,
        height,
        autoAlpha: 1,
        duration: 0.46,
        ease: "expo.out",
        force3D: true,
        overwrite: "auto",
      });
    };

    const filtered = () =>
      cards.filter((card) => {
        const matchesCategory = filter === "all" || card.dataset.category === filter;
        const matchesQuery = !query || (card.dataset.search ?? "").includes(query);
        return matchesCategory && matchesQuery;
      });

    const pageCount = () => Math.max(1, Math.ceil(filtered().length / pageSize));

    const renderPages = () => {
      if (!pageList || !pageTpl) return;
      const total = pageCount();
      pageList.replaceChildren();

      for (let index = 1; index <= total; index += 1) {
        const item = pageTpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        const button = item.querySelector("button")!;
        button.textContent = String(index);
        button.dataset.page = String(index);
        button.setAttribute("aria-label", `Page ${index}`);
        if (index === page) button.setAttribute("aria-current", "page");
        pageList.append(item);
      }

      if (pager) pager.hidden = filtered().length === 0;
      if (prev) prev.disabled = page <= 1;
      if (next) next.disabled = page >= total;
    };

    const apply = () => {
      const matches = filtered();
      page = Math.min(Math.max(page, 1), pageCount());

      const start = (page - 1) * pageSize;
      const visible = new Set(matches.slice(start, start + pageSize));

      for (const card of cards) card.hidden = !visible.has(card);

      if (empty) empty.hidden = matches.length > 0;
      renderPages();

      if (status) {
        const what = filter === "all" ? "all categories" : `the ${filter} category`;
        status.textContent = matches.length
          ? `${matches.length} article${matches.length === 1 ? "" : "s"} in ${what}, page ${page} of ${pageCount()}.`
          : `No articles in ${what}.`;
      }
    };

    const tweenGridHeight = (beforeHeight: number, duration = 0.48) => {
      if (!grid) return;
      gsap.set(grid, { height: "auto" });
      const afterHeight = grid.offsetHeight;
      if (beforeHeight === afterHeight) return;

      heightTween = gsap.fromTo(
        grid,
        { height: beforeHeight },
        {
          height: afterHeight,
          duration,
          ease: "expo.out",
          onComplete: () => {
            gsap.set(grid, { clearProps: "height" });
          },
        },
      );
    };

    const revealEmpty = () => {
      if (empty && !empty.hidden) {
        gsap.fromTo(
          empty,
          { autoAlpha: 0, y: 12 },
          { autoAlpha: 1, y: 0, duration: 0.42, delay: 0.08, ease: "expo.out" },
        );
      }
    };

    /** Smoothly choreograph tab/search/page transitions without CSS-transition conflicts. */
    const applyAnimated = () => {
      if (reduced || !grid) {
        apply();
        return;
      }

      activeAnim?.kill();
      heightTween?.kill();
      gsap.killTweensOf(cards);
      if (empty) gsap.killTweensOf(empty);

      const prevVisible = cards.filter((card) => !card.hidden);
      const nextMatches = filtered();
      const nextPage = Math.min(Math.max(page, 1), Math.max(1, Math.ceil(nextMatches.length / pageSize)));
      const nextStart = (nextPage - 1) * pageSize;
      const nextVisibleSet = new Set(nextMatches.slice(nextStart, nextStart + pageSize));
      const surviving = prevVisible.filter((card) => nextVisibleSet.has(card));

      const beforeHeight = grid.offsetHeight;

      // Case A: Disjoint swap (e.g. switching between two categories with 0 shared cards).
      // A crisp staggered exit -> DOM swap -> staggered expo-out entrance avoids card overlap.
      if (prevVisible.length > 0 && surviving.length === 0) {
        gsap.set(grid, { height: beforeHeight });

        const tl = gsap.timeline();
        activeAnim = tl;

        tl.to(prevVisible, {
          autoAlpha: 0,
          y: -14,
          scale: 0.965,
          duration: 0.2,
          stagger: 0.025,
          ease: "power2.in",
          force3D: true,
        }).add(() => {
          gsap.set(prevVisible, { clearProps: "transform,opacity,visibility" });
          apply();
          tweenGridHeight(beforeHeight, 0.46);

          const entering = cards.filter((card) => !card.hidden);
          if (entering.length) {
            gsap.fromTo(
              entering,
              { autoAlpha: 0, y: 24, scale: 0.965 },
              {
                autoAlpha: 1,
                y: 0,
                scale: 1,
                duration: 0.54,
                stagger: 0.055,
                ease: "expo.out",
                force3D: true,
                clearProps: "transform,opacity,visibility",
              },
            );
          }
          revealEmpty();
        });

        return;
      }

      // Case B: Overlapping set (e.g. All <-> category or live search).
      // Use GPU-composited GSAP Flip with `simple: true` and `scale: false` so surviving cards glide crisply.
      const state = Flip.getState(cards);

      apply();
      tweenGridHeight(beforeHeight, 0.54);

      activeAnim = Flip.from(state, {
        targets: cards,
        duration: 0.56,
        ease: "expo.out",
        absolute: true,
        simple: true,
        scale: false,
        stagger: 0.025,
        onEnter: (elements) =>
          gsap.fromTo(
            elements,
            { autoAlpha: 0, y: 22, scale: 0.965 },
            {
              autoAlpha: 1,
              y: 0,
              scale: 1,
              duration: 0.52,
              delay: 0.06,
              stagger: 0.045,
              ease: "expo.out",
              force3D: true,
              overwrite: "auto",
            },
          ),
        onLeave: (elements) =>
          gsap.to(elements, {
            autoAlpha: 0,
            scale: 0.95,
            y: 10,
            duration: 0.22,
            ease: "power2.in",
            force3D: true,
            overwrite: "auto",
          }),
        onComplete: () => {
          cards.forEach((card) => {
            if (!card.hidden) gsap.set(card, { clearProps: "transform,opacity,visibility" });
          });
        },
      });

      revealEmpty();
    };

    const setFilter = (id: string) => {
      if (id === filter) return;
      filter = id;
      page = 1;
      for (const tab of tabs) tab.setAttribute("aria-pressed", String(tab.dataset.filter === id));
      const activeTab = tabs.find((tab) => tab.dataset.filter === id);
      moveIndicator(activeTab, false);
      applyAnimated();
    };

    const goTo = (target: number) => {
      const clamped = Math.min(Math.max(target, 1), pageCount());
      if (clamped === page) return;
      page = clamped;
      applyAnimated();
    };

    for (const tab of tabs) {
      tab.addEventListener("click", (event) => {
        const button = (event.currentTarget as HTMLElement).closest<HTMLButtonElement>("[data-blog-tab]");
        if (button?.dataset.filter) setFilter(button.dataset.filter);
      });
    }

    pageList?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-page]");
      if (button?.dataset.page) goTo(Number(button.dataset.page));
    });

    prev?.addEventListener("click", () => goTo(page - 1));
    next?.addEventListener("click", () => goTo(page + 1));

    searchForm?.addEventListener("submit", (event) => event.preventDefault());
    searchInput?.addEventListener("input", () => {
      const nextQuery = searchInput.value.trim().toLowerCase();
      if (nextQuery === query) return;
      query = nextQuery;
      page = 1;
      applyAnimated();
    });

    const onResize = () => {
      const activeTab = tabs.find((tab) => tab.dataset.filter === filter);
      moveIndicator(activeTab, true);
    };
    window.addEventListener("resize", onResize);

    apply();
    moveIndicator(tabs[0], true);

    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("resize", onResize);
        activeAnim?.kill();
        heightTween?.kill();
      },
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", initBlogGrid);
  initBlogGrid();
</script>
