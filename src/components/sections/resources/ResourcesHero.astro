---
// Copy mirrors the design; the explicit break keeps "& Answers" on its own line
// at desktop widths and lets it reflow on small screens.
---

<section
  class="relative overflow-hidden bg-white pb-10 pt-[calc(var(--spacing-nav)+clamp(40px,5.6vw,80px))]"
  aria-labelledby="resources-hero-title"
  data-res-hero
>
  <div class="mx-auto w-full max-w-[1440px] px-6 lg:px-[82px]">
    <div class="mx-auto flex w-full max-w-[820px] flex-col items-center gap-8 lg:gap-[32px]">
      <div class="flex flex-col items-center gap-4 lg:gap-[16px]">
        <div class="flex items-center gap-2" data-res-eyebrow>
          <img
            src="/images/resources/hero/book-closed.svg"
            alt=""
            aria-hidden="true"
            width="24"
            height="24"
            class="size-6 flex-none"
          />
          <p class="m-0 font-sans text-sm font-medium leading-[22.5px] text-ink">
            Latch Resources &amp; Insights
          </p>
        </div>

        <h1
          id="resources-hero-title"
          class="m-0 w-full max-w-[730px] text-balance text-center font-display text-[clamp(36px,5vw,72px)] leading-[1.2] tracking-normal text-ink"
          style="font-variation-settings: 'SERF' 50, 'wght' 470"
          data-res-title
        >
          Security Guides<br class="max-sm:hidden" /> &amp; Answers
        </h1>
      </div>

      <form
        class="res-search flex w-full max-w-[484px] items-center gap-3 rounded-[40px] border border-border-badge bg-white px-4 py-3.5"
        role="search"
        action="/resources"
        method="get"
        data-res-search
      >
        <label class="sr-only" for="resources-search">Search articles, guides, or blogs</label>
        <svg
          class="size-5 flex-none text-ink-muted"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.67" />
          <path d="M15.4 15.4 18 18" stroke="currentColor" stroke-width="1.67" stroke-linecap="round" />
        </svg>
        <input
          id="resources-search"
          type="search"
          name="q"
          placeholder="Search article, guides, or blogs ...."
          class="m-0 h-6 w-full border-0 bg-transparent font-sans text-base leading-6 text-ink outline-none placeholder:text-[#677489]"
          autocomplete="off"
        />
      </form>
    </div>
  </div>
</section>

<style>
  .res-search {
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .res-search:focus-within {
    border-color: #c9d4e6;
    box-shadow: 0 0 0 3px rgb(94 113 255 / 0.12);
  }

  /* Native search widgets add their own clear button and rounding. */
  .res-search input[type="search"]::-webkit-search-decoration,
  .res-search input[type="search"]::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .res-search {
      transition: none;
    }
  }
</style>
