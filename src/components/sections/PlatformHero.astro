---
import CtaButton from "../CtaButton.astro";

const ctas = [
  { label: "Start for free", href: "/signup", variant: "primary" as const },
  { label: "Book a demo", href: "/contact", variant: "secondary" as const },
];
---

<section
  class="relative isolate overflow-hidden bg-hero-bg"
  aria-labelledby="platform-hero-title"
  data-platform-hero
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="absolute inset-x-0 bottom-0 h-[39%] md:h-[42%] lg:bottom-[-247px] lg:h-[674px]"
      data-ph-pattern
    >
      <div class="platform-pattern absolute inset-0" aria-hidden="true"></div>
      <div
        class="absolute inset-x-0 top-0 h-[100px] bg-linear-to-b lg:h-[150px] from-hero-bg to-[rgb(241_246_253_/_0)]"
      >
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[100px] bg-linear-to-b lg:h-[150px] from-[rgb(241_246_253_/_0)] to-hero-bg"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-full max-w-[1440px]">
    <div class="px-[clamp(24px,8.333vw,120px)] pt-[calc(var(--spacing-nav)+80px)]">
      <div class="mx-auto max-w-[1200px]">
        <div class="flex items-center gap-2" data-ph-eyebrow>
          <img
            src="/images/platforms/hero/shield-tick.svg"
            alt=""
            aria-hidden="true"
            width="24"
            height="24"
            class="size-6 flex-none"
          />
          <p class="m-0 font-sans text-sm font-medium leading-[22.5px] text-ink">
            One layer for continuous security
          </p>
        </div>

        <div class="mt-4 flex flex-col gap-8 min-[1180px]:flex-row min-[1180px]:items-center min-[1180px]:justify-between min-[1180px]:gap-10">
          <h1
            id="platform-hero-title"
            class="m-0 max-w-[532px] font-display text-[clamp(36px,5vw,72px)] leading-[1.3] tracking-normal text-ink font-mix-medium min-[1180px]:shrink-0"
            data-ph-title
          >
            Security That Runs 24/7
          </h1>

          <div class="min-w-0 max-w-[606px]">
            <p
              class="m-0 font-sans text-[20px] leading-[30px] text-pretty text-ink-muted"
              data-ph-copy
            >
              Latch unifies continuous testing, identity-aware access, and real-time
              response into a single platform that protects.
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-[11px]">
              {
                ctas.map((cta) => (
                  <CtaButton href={cta.href} variant={cta.variant} size="sm" data-ph-cta>
                    {cta.label}
                  </CtaButton>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="px-6 lg:px-0">
      <img
        src="/images/platforms/hero/Illustration.png"
        alt="Latch platform connecting applications, AI security and API requests through one layer"
        width="1544"
        height="1106"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="mx-auto mt-10 block w-full max-w-[772px] lg:mx-0 lg:mt-[38px] lg:ml-[21.35%] lg:w-[53.65%] lg:max-w-none"
        data-ph-art
      />
    </div>

    <div class="pb-8 lg:pb-[31px]"></div>
  </div>
</section>

<style>
  /* Dot grid: 16 x 13px cells, dot radius 3.6px, calibrated to the reference
     amplitude. CSS rather than the 12.8 MB halftone bitmap the export embeds. */
  .platform-pattern {
    background-image: radial-gradient(
      circle at center,
      rgb(64 105 178 / 0.065) 0 3.6px,
      rgb(64 105 178 / 0) 6.2px
    );
    background-size: 16px 13px;
  }
</style>
