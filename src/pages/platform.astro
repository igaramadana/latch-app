import PlatformHero from "../components/sections/platform/PlatformHero.astro";
import Overview from "../components/sections/platform/Overview.astro";
import Capabilities from "../components/sections/platform/Capabilities.astro";
import KeyBenefits from "../components/sections/platform/KeyBenefits.astro";
